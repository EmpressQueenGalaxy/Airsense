{
  "version": 2,
  "buildCommand": "pnpm frontend:build",
  "outputDirectory": "frontend/dist",
  "builds": [
    { "src": "backend/index.js", "use": "@vercel/node" },
    { "src": "frontend/dist/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/index.js" },
    { "src": "/assets/(.*)", "dest": "/frontend/dist/assets/$1" },
    { "src": "/(favicon\\.svg|og-image\\.svg|robots\\.txt|sitemap\\.xml)", "dest": "/frontend/dist/$1" },
    { "src": "/(.*)", "dest": "/frontend/dist/index.html" }
  ]
}
